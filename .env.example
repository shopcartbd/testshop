# ---------------------------------------------------------------------------
# AllStore - copy to .env for local development. NEVER commit .env.
# Production: set these in the Vercel Project > Settings > Environment Variables
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# Vercel injects PORT at runtime; do NOT set PORT manually in project settings.
# Production APP_URL must be the real https:// domain (used by Stripe redirects).
# ---------------------------------------------------------------------------
APP_NAME=AllStore
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT
APP_LOCALE=en

# --- Database --------------------------------------------------------------
# local | pgsql
# "local" uses SQLite at storage/allstore.sqlite (development & tests only).
DB_DRIVER=local
# Production: paste the Supabase "Transaction pooler" URI (port 6543) or the
# session pooler URI (port 5432). sslmode=require is enforced by the app.
# DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require
# Alternatively set SUPABASE_DB_HOST / _PORT / _NAME / _USER / _PASSWORD / _SSLMODE
# Vercel/Supabase aliases also accepted: SUPABASE_DB_URL, POSTGRES_URL,
# POSTGRES_URL_NON_POOLING. VERCEL_ENV/VERCEL_URL are used as fallbacks only.
# DB_POOL_MODE=transaction   # transaction => emulated prepares (Supavisor), session => native prepares

# --- Supabase (Storage + optional REST) ------------------------------------
# SUPABASE_URL=https://<REF>.supabase.co
# Server-side ONLY. Use the new sb_secret_... key or the legacy service_role JWT.
# SUPABASE_SECRET_KEY=
# Legacy alternative (server-side only): SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=product-images
# SUPABASE_PRIVATE_BUCKET=private-documents

# --- Security --------------------------------------------------------------
# 32+ random bytes, hex/base64. Required in production (server-side only).
# APP_KEY=
SESSION_IDLE_TIMEOUT=7200
CSRF_HEADER_NAME=X-CSRF-TOKEN
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900

# --- First administrator (CLI bootstrap only, never read by the web app) ----
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_PASSWORD=   # set a strong unique value; never commit it
# ADMIN_BOOTSTRAP_NAME=Store Owner

# --- Optional integrations (leave empty = feature disabled, never faked) ----
# MAIL_PROVIDER_URL=
# MAIL_API_KEY=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=AllStore
# PAYMENT_PROVIDER=stripe
# PAYMENT_GATEWAY_SECRET=sk_test_...
# PAYMENT_WEBHOOK_SECRET=whsec_...
# LOG_LEVEL=info
