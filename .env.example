APP_NAME=AllStore
APP_ENV=production
APP_CURRENCY=BDT
APP_URL=https://example.com
LOG_LEVEL=error

# Choose either SUPABASE_DB_URL or the component variables below.
# Use a least-privilege PostgreSQL login; never expose this to browser code.
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Vercel container instances have ephemeral filesystems. Use PostgreSQL-backed sessions.
# The handler holds session advisory locks; use a direct or Session-pooler DB connection.
SESSION_DRIVER=database

# Optional transactional email (PHPMailer uses authenticated SMTP with STARTTLS).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AllStore

# Optional image uploads; never expose the Storage service-role key to browser code.
SUPABASE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-media

# Strongly recommended: unique server-only random value for rate-limit bucket HMACs.
APP_KEY=
